{
  "schema": "isograph.domain-neutral-demand-extraction-rules.v0.1",
  "date": "2026-10-05",
  "status": "FROZEN_PRE_EXTRACTION",
  "source_corpus": "SOURCE_DEMAND_CENSUS_0_1.json",
  "rule": "Each rule is triggered only by frozen-body surface language. Output IDs are domain-neutral structural demand fingerprints. Trigger words are evidence locators, not primitive names.",
  "core_already_qualified": [
    "AND",
    "OR",
    "NOT",
    "IMPLIES",
    "IFF",
    "FORALL",
    "EXISTS",
    "EQUAL",
    "PREDICATE_APPLICATION",
    "RAW_CARRIER",
    "RAW_VALUE",
    "DEFINITION_EXPANDS_TO"
  ],
  "demand_rules": [
    {
      "id": "PD-MAP-APPLY",
      "regex": "(map|maps|mapping|operator|transform|sends|sending|acts? on|action on|representation|represents|represented|apply|application|flow|diffeomorphism)",
      "fingerprint": "typed mapping/application semantics",
      "requires": [
        "B-TYPED-MAP"
      ]
    },
    {
      "id": "PD-COMPOSE",
      "regex": "(compos|product|multiplication|multiply|bracket|commutator|wedge|tensor|concatenat|fractional-linear|fractional linear|super-bracket)",
      "fingerprint": "operation/composition semantics with laws",
      "requires": [
        "B-TYPED-MAP",
        "B-FINITE-PRODUCT-INDEX",
        "B-OPERATION-LAW"
      ]
    },
    {
      "id": "PD-ID-INVERSE",
      "regex": "(identity|inverse|invert|order-[0-9]+|order [0-9]+|involution|squared|square-minus-one|square minus one)",
      "fingerprint": "identity/inverse/finite-order law over a map or operation",
      "requires": [
        "B-TYPED-MAP",
        "B-OPERATION-LAW"
      ]
    },
    {
      "id": "PD-ACTION-LAW",
      "regex": "(acts? on|action|representation|generator|covariant|transforms? under|symmetry|automorphism|rotation)",
      "fingerprint": "action compatibility between an acting operation and a carrier",
      "requires": [
        "B-TYPED-MAP",
        "B-FINITE-PRODUCT-INDEX",
        "B-OPERATION-LAW"
      ]
    },
    {
      "id": "PD-LINEAR",
      "regex": "(linear|vector|spinor|matrix|scalar|basis|coefficient|weight|root|bivector|tensor|exterior|clifford)",
      "fingerprint": "additive/scalar combination and linearity semantics",
      "requires": [
        "B-TYPED-MAP",
        "B-FINITE-PRODUCT-INDEX",
        "B-ADDITIVE-SCALAR"
      ]
    },
    {
      "id": "PD-FORM-PAIRING",
      "regex": "(hermitian|inner product|pairing|metric|killing form|bilinear|trilinear|quadratic|trace|determinant|norm|form\\b)",
      "fingerprint": "multilinear/pairing/quadratic functional semantics",
      "requires": [
        "B-TYPED-MAP",
        "B-FINITE-PRODUCT-INDEX",
        "B-ADDITIVE-SCALAR",
        "B-MULTILINEAR-FORM"
      ]
